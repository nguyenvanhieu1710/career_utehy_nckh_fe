{
  "*.{ts,tsx}": [
    "eslint --fix --max-warnings=0 --no-warn-ignored",
    "prettier --write",
    "node -e \"require('child_process').execSync('tsc --noEmit', { stdio: 'inherit' })\""
  ],
  "*.{js,mjs,cjs}": ["prettier --write"],
  "*.{json,md,yml,yaml}": ["prettier --write"],
  "*.{scss,css}": ["prettier --write"]
}
